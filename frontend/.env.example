# Template for a NEW LOCAL DEV environment. Copy to .env.local and adjust.
# For production, .env.production is committed and already correct — do not use this file there.
#
# Only NEXT_PUBLIC_* variables are read by the frontend code; they are inlined into the
# client bundle at build time, so NEVER put a secret in this file or in any .env here.

# Base URL of the Laravel API. The only variable the frontend code reads
# (src/lib/api.ts — every backend call goes through that module).
# In dev the frontend runs on the host at :3000 and Sail serves Laravel on :80,
# so an absolute URL is required. Leave it unset and api.ts falls back to this
# same value; it is listed here so a new environment can override it explicitly.
NEXT_PUBLIC_API_URL=http://localhost/api
